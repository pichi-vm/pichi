/target
/.codex
/demo

# Editor swap files
*~
*.swp
*.swo

Cargo.toml.bak*

# Test fixtures are generated on the fly into TempDirs, never committed.
# Guard against accidentally sweeping a generated disk image into a commit
# (use `git add -f` if a binary genuinely needs to be tracked).
*.raw
*.img
**/tests/fixtures/

# Keep all copied dependency sources, including test fixtures and images.
!/vendor/
!/vendor/**
!/vendor-conglobate/
!/vendor-conglobate/**

# Debian build products.
/debian/cargo-home/
/debian/pichi/
/debian/.debhelper/
/debian/debhelper-build-stamp
/debian/files
/debian/*.substvars
/debian/*.debhelper.log
