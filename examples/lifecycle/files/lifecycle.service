[Unit]
Description=Pichi lifecycle demo
SuccessAction=poweroff

[Service]
Type=oneshot
ExecStart=/usr/bin/printf "Hello from Pichi.\nWorkload complete. Shutting down.\n"
StandardOutput=tty
StandardError=tty
TTYPath=/dev/hvc0

[Install]
WantedBy=multi-user.target
