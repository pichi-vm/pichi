[Unit]
Description=Pichi lifecycle demo
Requires=dracut-shutdown.service
After=dracut-shutdown.service
SuccessAction=poweroff

[Service]
Type=oneshot
ExecStart=/usr/bin/printf "Hello from Pichi.\nWorkload complete. Shutting down.\n"
StandardOutput=tty
StandardError=tty
TTYPath=/dev/hvc0
