#
# Static virtiofs mount: tag `output` → `/run/pichi/output`.
# Tags are image/unit config only — never parsed from appliance CBOR.

[Unit]
Description=Pichi build virtiofs (output → /run/pichi/output)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target conglobate-build.service
After=systemd-remount-fs.service systemd-modules-load.service

[Mount]
What=output
Where=/run/pichi/output
Type=virtiofs
Options=rw

[Install]
WantedBy=local-fs.target
