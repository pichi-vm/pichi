[Unit]
Description=Establish build appliance time with NTP then NTS
Wants=network-online.target
Requires=systemd-resolved.service
After=network-online.target systemd-resolved.service systemd-modules-load.service
ConditionPathExistsGlob=/sys/class/net/*/device
FailureAction=poweroff

[Service]
Type=oneshot
RuntimeDirectory=chrony
BindReadOnlyPaths=/run/systemd/resolve/resolv.conf:/etc/resolv.conf
# Command-line directives bypass the distribution's chrony.conf.
# Plain NTP only bootstraps the clock for normal TLS certificate validation.
# One-shot clock setup needs an offset sample, not frequency tracking.
ExecStart=/usr/sbin/chronyd -d -q -t 60 -u root "server time.cloudflare.com iburst maxsamples 1"
ExecStart=/usr/sbin/chronyd -d -q -t 60 -u root "server time.cloudflare.com iburst nts maxsamples 1"
TimeoutStartSec=150
RemainAfterExit=yes
