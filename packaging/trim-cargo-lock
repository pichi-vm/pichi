#!/bin/bash
# SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail

# Run in the scratch source copy after applying the packaging manifest patch.
original_lock=$(mktemp)
trap 'rm -f "$original_lock"' EXIT
cp Cargo.lock "$original_lock"
cargo update --workspace
awk -v RS='' -F '\n' '/^\[\[package\]\]/ {
    pin = "";
    for (i = 1; i <= NF; i++)
        if ($i ~ /^(name|version|source|checksum) = /) pin = pin $i ORS;
    if (FILENAME == ARGV[1]) pins[pin] = 1;
    else if (!(pin in pins)) {
        print "Packaging lock introduced a new package pin:\n" pin > "/dev/stderr";
        exit 1;
    }
}' "$original_lock" Cargo.lock
