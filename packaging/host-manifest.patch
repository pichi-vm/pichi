--- a/Cargo.toml
+++ b/Cargo.toml
@@ -11,14 +11,6 @@

 [lints]
 workspace = true
-
-[features]
-# Gates the KVM/boot integration tests (build_*.rs). The default `cargo test`
-# does not pull in the boot deps (arma/dillo/corium artifacts); CI
-# runs them explicitly: `cargo test -p pichi --features vm-tests`. The product
-# artifacts are optional [dependencies] so non-vm builds never resolve them
-# (the registry/workspace jobs would otherwise drag in cross-target binaries).
-vm-tests = ["dep:arma", "dep:dillo", "dep:corium"]

 [dependencies]
 anyhow.workspace = true
@@ -57,18 +49,10 @@
 ruzstd = "0.9.1"
 # Product binaries the boot tests orchestrate (host target). Optional so only
 # `vm-tests` resolves them; a plain `cargo test` pulls zero product artifacts.
-arma = { git = "https://github.com/pichi-vm/arma", rev = "3297920b46122689fb13ca41acd61cbe94ac1de7", artifact = "bin", optional = true }
-dillo = { git = "https://github.com/pichi-vm/dillo", rev = "70305271cdb6bb54e165897b87c0e44c91ea4d90", artifact = "bin", optional = true }
 crossterm = { version = "0.29", default-features = false, features = ["windows"] }

 # Optional guest Corium binaries for `vm-tests` only. Production builds launch
 # Conglobate's shipped appliance; the host consumes its types-only library.
-[target.'cfg(target_arch = "x86_64")'.dependencies]
-corium = { git = "https://github.com/pichi-vm/corium", rev = "c33ae0e01d58b657f8f62cb91672885326a903b9", artifact = "bin", lib = false, target = "x86_64-unknown-linux-musl", optional = true }
-
-[target.'cfg(target_arch = "aarch64")'.dependencies]
-corium = { git = "https://github.com/pichi-vm/corium", rev = "c33ae0e01d58b657f8f62cb91672885326a903b9", artifact = "bin", lib = false, target = "aarch64-unknown-linux-musl", optional = true }
-
 [target.'cfg(not(target_os = "linux"))'.dependencies]
 sysinfo = { version = "0.40", default-features = false, features = ["system"] }

@@ -81,26 +65,6 @@
 windows-spawn = "=0.1.0"
 widestring = "1"
 win-custody = "=0.1.2"
-
-[dev-dependencies]
-gpt.workspace = true
-assert_cmd.workspace = true
-tempfile.workspace = true
-pichi-storage.workspace = true
-# Test-only: round-trip the `--gpt` kv string `cmd::run` emits back through
-# dillo's device schema to guarantee the format parses as intended. Not a
-# runtime dependency — pichi and dillo are coupled only via dillo's CLI.
-dillo-config.workspace = true
-serde-keyvalue.workspace = true
-# KVM/boot integration tests (build_*.rs, gated on `vm-tests`). These drive the
-# real product binaries through their CLIs; the artifact deps build them.
-wait-timeout = "0.2"
-hex = "0.4"
-burrow = { workspace = true }
-
-[target.'cfg(windows)'.dev-dependencies]
-win32job = "=2.0.3"
-winsafe = { version = "=0.0.29", features = ["user"] }

 [workspace]
 resolver = "2"
