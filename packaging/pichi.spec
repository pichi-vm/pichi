# Generated by rust2rpm 28 and hand-tuned for this workspace.
#
# rust2rpm's crates.io skeleton (%cargo_prep / %cargo_build / %cargo_install)
# does not fit a workspace whose dependencies are git crates. This spec vendors
# Cargo.lock, builds the host `pichi` binary only, and never talks to the
# network in %build.
#
# Copr SCM (default rpkg-util v3) preprocesses the {{{ }}} macros. Point the
# package at this file (packaging/pichi.spec). git_repo_pack archives the
# whole tree, including vendor/.
#
# vm-tests artifact deps (arma, dillo, conglobate/corium bins) and the root
# dev-dependencies are patched out in %prep. They are not needed to compile
# the CLI, and cargo still fetches unused git deps when they remain in the
# manifest. Two carapace 0.1.0 crates (pichi's pinned rev, conglobate's
# floating rev) cannot share one vendor directory entry; the floating crate
# is vendored as 0.1.1 and rpm-lock.patch retargets the lock.
#
# cargo-rpm-macros ships %cargo_prep -v on Fedora 43+ and on EPEL 9/10.
# centos-stream chroots do not enable EPEL; those builds need the EPEL repo
# so BuildRequires: cargo-rpm-macros resolves.

%bcond check 0

# The library target exists for integration tests. Ship the CLI only.
%global cargo_install_lib 0

Name:           pichi
Version:        {{{ git_repo_version lead=0.1 follow=0 }}}
Release:        1%{?dist}
Summary:        Front-end for pichi VM images
License:        Apache-2.0 AND MIT AND Unicode-3.0 AND Zlib AND ISC AND BSD-3-Clause AND Unlicense AND BSL-1.0 AND CDLA-Permissive-2.0
URL:            https://github.com/pichi-vm/pichi
VCS:            {{{ git_repo_vcs }}}
Source:         {{{ git_repo_pack }}}

# Fedora and EPEL. Not in CentOS Stream AppStream; see the header note.
BuildRequires:  cargo-rpm-macros >= 24
BuildRequires:  cmake
BuildRequires:  gcc
BuildRequires:  gcc-c++
BuildRequires:  make

ExclusiveArch:  x86_64 aarch64

%global _description %{expand:
Host CLI that manages pichi VM images as OCI artifacts and launches them.
This package does not ship guest images.}

%description %{_description}

%prep
{{{ git_repo_setup_macro }}}
patch -p1 -i packaging/rpm-manifest.patch
patch -p1 -i packaging/rpm-lock.patch
%cargo_prep -v vendor
cat packaging/cargo-vendor-sources.toml >> .cargo/config.toml

%build
%cargo_build --locked --offline

%install
%cargo_install --locked --offline

%if %{with check}
%check
%cargo_test --locked --offline
%endif

%files
%license LICENSE
%doc README.md
%{_bindir}/pichi

%changelog
* Tue Oct 27 2026 pichi packaging <packaging@pichi.invalid> - 0.1.0-1
- Package the pichi host CLI for Copr with a vendored Cargo.lock.
