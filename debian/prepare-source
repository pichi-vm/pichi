#!/bin/bash
# SPDX-FileCopyrightText: Advanced Micro Devices, Inc.
# SPDX-License-Identifier: Apache-2.0
set -euo pipefail
export LC_ALL=C

cd "$(dirname "$0")/.."
if [[ -n $(git status --porcelain) ]]; then
    echo 'Commit or remove local changes before refreshing sources.' >&2
    exit 1
fi
ref=${1:-origin/main}
workdir=$(mktemp -d)
trap 'rm -rf "$workdir"' EXIT

git show "$ref:Cargo.toml" > Cargo.toml
git show "$ref:Cargo.lock" > Cargo.lock
patch --no-backup-if-mismatch -p1 < packaging/host-manifest.patch
packaging/trim-cargo-lock
cp Cargo.toml "$workdir/host-Cargo.toml"
cp Cargo.lock "$workdir/host-Cargo.lock"
cargo fetch --locked
rm -rf vendor vendor-conglobate

sed '/^carapace.workspace = true$/d' "$workdir/host-Cargo.toml" > Cargo.toml
cargo metadata --offline --format-version 1 > /dev/null
cargo vendor --locked --versioned-dirs vendor-conglobate > "$workdir/conglobate.toml"
sed -i 's/vendored-sources/vendored-conglobate/g' "$workdir/conglobate.toml"

cp "$workdir/host-Cargo.lock" Cargo.lock
sed '/^conglobate.workspace = true$/d' "$workdir/host-Cargo.toml" > Cargo.toml
cargo metadata --offline --format-version 1 > /dev/null
cargo vendor --locked --versioned-dirs vendor > "$workdir/pichi.toml"
tar -C vendor-conglobate --exclude='./carapace-0.1.0' -cf - . |
    tar -C vendor -xf - --skip-old-files
awk '/^\[/ { key = $0; if (!(key in tables)) keys[++count] = key; tables[key] = "" }
     { tables[key] = tables[key] $0 ORS }
     END { for (i = 1; i <= count; i++) printf "%s", tables[keys[i]] }' \
    "$workdir/conglobate.toml" "$workdir/pichi.toml" > .cargo/vendor.toml

cp "$workdir/host-Cargo.toml" Cargo.toml
cp "$workdir/host-Cargo.lock" Cargo.lock
# Include files matched by upstream crates' own ignore rules, too.
git add Cargo.toml Cargo.lock .cargo/vendor.toml
git add -f vendor vendor-conglobate
if ! git diff --cached --quiet; then
    git commit -m 'build: refresh vendored sources' \
        -m 'Refresh the copied dependency sources so builds need no network.'
fi
